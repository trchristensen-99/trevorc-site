.","color":"#d08a3a","label":[98.454,23.554],"km2":8909},"TNLA":{"name":"Ta'ang (TNLA)","formal":"Ta'ang National Liberation Army","kind":"armed group","note":"Holds Namhsan, Mantong, Namhkan and Namtu; returned Mogok, Kyaukme, Hsipaw and Nawnghkio to the junta under Chinese pressure.","color":"#3f8f6a","label":[97.298,23.191],"km2":7775},"KIA":{"name":"Kachin Independence Army","kind":"armed group","color":"#2a6a3a","label":[97.956,26.232],"km2":23377},"CHINR":{"name":"Chin resistance forces","kind":"armed group","color":"#7a2a3a"},"NUG":{"name":"National Unity Government and PDFs","kind":"armed group","color":"#a03030"},"KNPP":{"name":"Karenni resistance forces","kind":"armed group","color":"#5a2a6a"},"KNU":{"name":"Karen National Union","kind":"armed group","color":"#2a4a8a"},"JNIM":{"name":"JNIM","formal":"Jama'at Nusrat al-Islam wal-Muslimin","kind":"armed group","color":"#2b2b2b"},"ISSP":{"name":"Islamic State Sahel","kind":"armed group","color":"#5a2a2a"},"FLA":{"name":"Azawad Liberation Front","kind":"armed group","color":"#8a7a2a"},"ISWAP":{"name":"Islamic State West Africa","kind":"armed group","color":"#4a2a4a"},"JAS":{"name":"Boko Haram (JAS)","kind":"armed group","color":"#2a2a2a"},"FANO":{"name":"Fano militias","kind":"armed group","color":"#3a6a2a"},"ISM":{"name":"Islamic State Mozambique","kind":"armed group","color":"#3a3a3a"},"AMBA":{"name":"Ambazonian separatists","kind":"armed group","color":"#2a4a8a"},"TTP":{"name":"Pakistani Taliban (TTP)","kind":"armed group","color":"#2a2a2a"},"BLA":{"name":"Baloch separatists","kind":"armed group","color":"#2a5a3a"},"ELN":{"name":"ELN","formal":"National Liberation Army","kind":"armed group","color":"#8a2020"},"EMC":{"name":"FARC dissidents (EMC)","kind":"armed group","color":"#5a1a1a"},"VIVANSANM":{"name":"Viv Ansanm gang coalition","kind":"armed group","color":"#3a3a3a"},"SPLAIO":{"name":"SPLA-in-Opposition","kind":"armed group","color":"#2a3a6a"},"ADF":{"name":"Allied Democratic Forces (IS Central Africa)